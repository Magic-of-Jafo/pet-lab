# Settings for scripts/deploy.sh. Copy to deploy.env (not committed) and edit.

# SSH login for the Docker host, and an SSH key if you need one
PETLAB_HOST=you@192.168.1.20
PETLAB_SSH_KEY=$HOME/.ssh/id_ed25519

# Folder on the host for Pet Lab (compose.yaml, workspace/, home/)
PETLAB_DIR=/srv/pet-lab

# User and group that own that folder on the host (`id -u`, `id -g`)
PETLAB_UID=1000
PETLAB_GID=1000

# How to run Docker on the host. Synology DSM 7 example:
#   PETLAB_DOCKER="sudo -n /usr/local/bin/docker"
#   PETLAB_COMPOSE="sudo -n /usr/local/bin/docker-compose"
PETLAB_DOCKER=docker
PETLAB_COMPOSE="docker compose"
